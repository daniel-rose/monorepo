{
  "name": "@daniel-rose/eslint-config",
  "version": "5.2.0",
  "license": "MIT",
  "author": "Daniel Rose",
  "keywords": [
    "eslint",
    "config"
  ],
  "type": "module",
  "scripts": {
    "build": "mkdir -p ./dist && cp index.js base.js react.js restrictions.js tailwind.js vitest.js ./dist/ && tsc -p tsconfig.build.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run && pnpm test:types"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "dependencies": {
    "@eslint/js": "catalog:prod",
    "eslint-config-prettier": "catalog:prod",
    "eslint-plugin-prettier": "catalog:prod",
    "typescript-eslint": "catalog:prod"
  },
  "peerDependencies": {
    "@vitest/eslint-plugin": "^1.6.0",
    "eslint": "^10",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-tailwindcss": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y-x": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@daniel-rose/prettier-config": "^2.0.0",
    "@daniel-rose/semantic-release-config": "^2.0.0",
    "@types/react": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y-x": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-tailwindcss": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-rose/monorepo.git",
    "directory": "configs/eslint"
  },
  "bugs": {
    "url": "https://github.com/daniel-rose/monorepo/issues"
  },
  "homepage": "https://github.com/daniel-rose/monorepo/blob/main/configs/eslint/README.md"
}
