{
  "name": "@daniel-rose/envex",
  "version": "5.0.0",
  "license": "MIT",
  "author": "Daniel Rose",
  "keywords": [
    "nextjs",
    "react",
    "runtime",
    "env",
    "environment",
    "php",
    "island-architecture"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "vitest",
    "test:unit:ci:pre": "playwright install",
    "test:unit:ci": "pnpm run test:unit:ci:pre && vitest --run --coverage --outputFile=coverage/junit.xml --reporter=junit --browser.headless"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./dev-tools": {
      "types": "./dist/dev-tools.d.ts",
      "import": "./dist/dev-tools.js"
    }
  },
  "peerDependencies": {
    "@secretlint/core": "^13",
    "@secretlint/secretlint-rule-preset-recommend": "^13",
    "next": "^15 || ^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@secretlint/core": {
      "optional": true
    },
    "@secretlint/secretlint-rule-preset-recommend": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@daniel-rose/eslint-config": "^2.0.0",
    "@daniel-rose/prettier-config": "^2.0.0",
    "@daniel-rose/semantic-release-config": "^2.0.0",
    "@secretlint/core": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-rose/monorepo.git",
    "directory": "packages/envex"
  },
  "bugs": {
    "url": "https://github.com/daniel-rose/monorepo/issues"
  },
  "homepage": "https://github.com/daniel-rose/monorepo/blob/main/packages/envex/README.md",
  "dependencies": {
    "@standard-schema/spec": "catalog:prod"
  }
}
